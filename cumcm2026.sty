\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cumcm2026}[2026/09/11 v2.0 CUMCM 2026 paper style - Professional Standard]

% 1. 页面设置（国赛标准：A4纸，上下左右边距均严格不少于 2.5cm，无页眉线，页脚中部连续阿拉伯数字页码）
\RequirePackage{geometry}
\geometry{a4paper,left=2.5cm,right=2.5cm,top=2.5cm,bottom=2.5cm,headheight=15pt,headsep=0pt,footskip=1.2cm}

% 2. 核心宏包引入
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{booktabs,array,tabularx,longtable,multirow}
\RequirePackage{graphicx,float,caption,subcaption}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{siunitx}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks,unicode]{hyperref}

% 3. 字体与西文字体配置（英文与数字优先使用 Times New Roman，与中文宋体完美搭配）
\setmainfont{Times New Roman}

% 4. 章节标题编号层级规范（科技论文标准：1, 1.1, 1.1.1）
\ctexset{
  section = {
    format = \heiti\zihao{4}\bfseries,
    beforeskip = 0.8em plus 0.1em minus 0.1em,
    afterskip = 0.4em plus 0.1em minus 0.1em,
    aftername = \quad
  },
  subsection = {
    format = \heiti\zihao{-4}\bfseries,
    beforeskip = 0.6em plus 0.1em minus 0.1em,
    afterskip = 0.3em plus 0.1em minus 0.1em,
    aftername = \quad
  },
  subsubsection = {
    format = \heiti\zihao{-4}\bfseries,
    beforeskip = 0.5em plus 0.1em minus 0.1em,
    afterskip = 0.25em plus 0.1em minus 0.1em,
    aftername = \quad
  }
}

% 5. 正文段落与行距规范
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\linespread{1.22} % 紧凑优雅的专业科技论文行距

% 公式上下间距优化，避免公式周围大面积留白
\setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}
\setlength{\abovedisplayshortskip}{0pt plus 2pt}
\setlength{\belowdisplayshortskip}{4pt plus 2pt}

% 列表环境紧凑排版，避免垂直跨度太大挤散页面
\setlist{leftmargin=2em,labelsep=0.5em,itemsep=0.15em,topsep=0.25em,parsep=0pt,partopsep=0pt}

% 6. 图表与标题格式规范（国赛三线表，表头在上，图题在下，五号字）
\captionsetup{font={small,bf},labelsep=quad,skip=5pt}
\captionsetup[table]{position=top}
\captionsetup[figure]{position=bottom}
\renewcommand{\figurename}{图}
\renewcommand{\tablename}{表}

% 7. 页眉页脚规范（国赛要求：不得出现除页码外的任何字符与线条，页码位于页脚中部，从第1页开始连续编号）
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\zihao{-5}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\zihao{-5}\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% 8. 题目与摘要页（第一页专用，不得超出一页）
\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \setcounter{page}{1}%
  \begin{center}
    \vspace*{-0.5em}
    {\heiti\zihao{2}\bfseries \@title\par}
  \end{center}
  \vspace{0.8em}
}
\makeatother

\newenvironment{cumcmabstract}
  {\begin{center}{\heiti\zihao{4}\bfseries 摘\quad 要\par}\end{center}\vspace{0.3em}\begingroup\zihao{-4}}
  {\par\endgroup\clearpage}

\newcommand{\cumcmkeywords}[1]{%
  \par\vspace{0.8em}\noindent{\heiti\zihao{-4}\bfseries 关键词：}#1
}

% 浮动体与正文间距优化（避免大面积留白）
\setlength{\textfloatsep}{10pt plus 2pt minus 2pt}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}

% 9. AI 工具使用声明（2026 国赛严格规范）
\newcommand{\CumcmAINotUsed}{%
  \par\vspace{0.2em}\noindent{\heiti\zihao{-4}\bfseries AI 工具使用声明}\par\vspace{0.1em}
  本参赛队在竞赛过程中未使用任何 AI 工具。\par
}

\newcommand{\CumcmAIUsed}[1]{%
  \par\vspace{0.2em}\noindent{\heiti\zihao{-4}\bfseries AI 工具使用声明}\par\vspace{0.1em}
  本参赛队在竞赛过程中使用了 AI 工具，主要用于 #1，详细使用情况见支撑材料。\par
}

% 参考文献紧凑格式（五号字，紧凑行距与列表间距，避免孤行页）
\makeatletter
\renewenvironment{thebibliography}[1]{%
  \par\vspace{0.6em}\noindent{\heiti\zihao{4}\bfseries\refname}\par\vspace{0.3em}%
  \@afterindentfalse\@afterheading
  \list{\@biblabel{\@arabic\c@enumiv}}%
       {\settowidth\labelwidth{\@biblabel{#1}}%
        \leftmargin\labelwidth
        \advance\leftmargin\labelsep
        \usecounter{enumiv}%
        \let\p@enumiv\@empty
        \renewcommand\theenumiv{\@arabic\c@enumiv}%
        \zihao{-5}%
        \setlength{\itemsep}{0pt}%
        \setlength{\parsep}{0pt}%
        \setlength{\topsep}{0pt}%
        \setlength{\parskip}{0pt}%
        \setlength{\partopsep}{0pt}}%
  \sloppy
  \clubpenalty4000
  \@clubpenalty \clubpenalty
  \widowpenalty4000%
  \sfcode`\.\@m}
 {\def\@noitemerr
   {\@latex@warning{Empty `thebibliography' environment}}%
  \endlist}
\makeatother

% 10. 命题与证明环境
\newenvironment{cumcmproof}
  {\par\noindent\textbf{证明：}\parindent=2em}
  {\hfill$\blacksquare$\par\vspace{0.5em}}

\sisetup{detect-all,group-minimum-digits=4}

\endinput
