%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Microsoft YaHei, Arial, sans-serif'}}}%%
flowchart TD
    subgraph R1[1. 约束构造与可行域求解]
        direction LR
        A([检测点坐标<br/>与有效示向度]) --> B[角度转换、坐标归一化<br/>构造前向半平面]
        B --> C[方向排序、合并同向约束<br/>双端队列半平面交]
        C --> D{可行域有效?}
        D -- 否 --> X([返回异常状态<br/>与诊断信息])
        D -- 是 --> E([得到逆时针<br/>凸多边形顶点])
    end

    subgraph R2[2. 直径与覆盖判定]
        direction LR
        F([接收有效<br/>凸多边形]) --> G[旋转卡壳求直径<br/>及最远点对]
        G --> H[以最远点中点为圆心<br/>逐顶点作点积检验]
        H --> I{启用独立复核?}
        I -- 否 --> O([输出顶点、直径、圆心<br/>与覆盖结论])
        I -- 是 --> V([进入复核链])
    end

    subgraph R3[3. 开发与验证模式下的独立复核]
        direction LR
        L([两两边界交点<br/>全约束筛选]) --> M[全部顶点对<br/>穷举直径]
        M --> N[圆心距离式<br/>复核覆盖]
        N --> P{两条路线一致?}
        P -- 是 --> O2([确认并输出结果])
        P -- 否 --> Q([返回数值不确定状态])
    end

    R1 -- 有效分支 --> R2
    R2 -- 启用复核时 --> R3
